# Optional OpenAI-compatible chat-completions provider
# Copy values into your local environment or .env file loader; never commit real secrets.
# Leave all three empty to use the built-in local script template at no API cost.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Set to 1 only if you want generation to fail instead of falling back to the local template.
AI_REQUIRE_REMOTE=0
